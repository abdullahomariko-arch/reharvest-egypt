# ReHarvest API configuration.
# The server refuses to start if any of these are missing.

PORT=8787

# Postgres. The app connects as reharvest_app, which has UPDATE and DELETE
# revoked on audit_log and weighings (see migrations/0001_invariants.sql).
DATABASE_URL=postgres://reharvest_app:CHANGE_ME@localhost:5432/reharvest

# Signs bearer tokens. Minimum 32 characters; the server rejects shorter.
# Generate with: openssl rand -base64 48
AUTH_SIGNING_SECRET=

# Paymob. From the merchant dashboard, Settings -> Account Info.
# The HMAC secret is what proves a webhook actually came from Paymob;
# treat it like a private key.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=

# Integration IDs per payment rail, comma separated if you have several.
PAYMOB_INTEGRATION_CARD=
PAYMOB_INTEGRATION_WALLET=
PAYMOB_INTEGRATION_KIOSK=
PAYMOB_INTEGRATION_BANK=
PAYMOB_INTEGRATION_BNPL=

# Encrypts bank account numbers at rest. Format: keyId:base64key, comma
# separated, first is active. Keys must be 32 bytes (AES-256).
# Generate with: echo "v1:$(openssl rand -base64 32)"
#
# When rotating, put the NEW key first and keep the old one listed until every
# row has been re-encrypted. Removing a key that rows still reference makes
# those rows unreadable.
FIELD_ENCRYPTION_KEYS=
