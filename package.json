{
  "name": "reharvest",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "node --import tsx --test packages/core/src/controls.test.ts packages/core/src/packaging.test.ts apps/api/src/service/payment-service.test.ts",
    "typecheck": "tsc --noEmit",
    "gen:controls": "node scripts/generate-controls.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "drizzle-kit": "^0.31.0"
  }
}