{
  "name": "reharvest",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "tsx --test packages/core/src/*.test.ts apps/api/src/service/*.test.ts",
    "typecheck": "tsc --noEmit && npm --prefix apps/mobile run typecheck",
    "gen:controls": "node scripts/generate-controls.mjs",
    "db:generate": "drizzle-kit generate",
    "export:web": "npm --prefix apps/mobile run export"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "drizzle-kit": "^0.31.0"
  }
}