{
  "name": "reharvest",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "tsx --test packages/core/src/*.test.ts apps/api/src/*.test.ts apps/api/src/service/*.test.ts apps/api/src/repo/*.test.ts",
    "typecheck": "tsc --noEmit && npm --prefix apps/mobile run typecheck",
    "gen:controls": "node scripts/generate-controls.mjs",
    "db:generate": "drizzle-kit generate",
    "export:web": "npm --prefix apps/mobile run export",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "db:migrate": "node scripts/migrate.mjs fresh",
    "db:seed": "tsx packages/db/scripts/seed.ts",
    "test:e2e": "node --import tsx apps/api/test/e2e.mjs",
    "test:db": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f packages/db/test/invariants.proof.sql",
    "db:proof": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f packages/db/test/invariants.proof.sql",
    "test:integration": "node scripts/run-integration.mjs",
    "keys:status": "tsx scripts/beneficiary-keys.ts status",
    "keys:rotate": "tsx scripts/beneficiary-keys.ts rotate",
    "keys:verify": "tsx scripts/beneficiary-keys.ts verify",
    "db:migrate:upgrade": "node scripts/migrate.mjs upgrade",
    "build": "node scripts/build-server.mjs",
    "start": "node dist/server.js"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "drizzle-kit": "^0.31.0"
  }
}